# ==========================================
# BudgetYatta — Environment Variables Reference
# ==========================================

# --- BACKEND (server/.env or Vercel Backend Project) ---
# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/budgetyatta?retryWrites=true&w=majority

# OpenAI Official SDK API Key (Optional: if omitted, deterministic mock generation engine is used)
OPENAI_API_KEY=

# OpenAI Model
OPENAI_MODEL=gpt-4o-mini

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173

# Local Server Port
PORT=5000

# --- FRONTEND (client/.env or Vercel Frontend Project) ---
# Backend API Base URL
VITE_API_URL=http://localhost:5000
